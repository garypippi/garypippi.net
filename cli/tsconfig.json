{
  "extends": "../tsconfig.json",
  "include": [
    "./**/*"
  ],
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": "./dist",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ]
  },
  "exclude": [
    "dist",
    "test"
  ]
}
